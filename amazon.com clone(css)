* {
    margin: 0;
    font-family: Arial;
    border: border-box;
}

.navbar {
    height: 60px;
    background-color: black;
    color: white;
    display: flex;
    align-items: center;
    justify-content: space-evenly;
}

.nav-logo {
    height: 50px;
    width: 100px;
}

.logo {
    background-image: url("https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTkXyHmHFvc7oj3HNpoDtU7YFAs16H2w562qA&s ");
    height: 50px;
    width: 100%;
    background-size: cover;
}

.border {
    border: 1.5px solid transparent;
}

.border:hover {
    border: 1.5px solid white;
}

/* box2*/
.add-first {
    color: #cccccc;
    font-size: 0.8rem;
    margin-left: 15px;


}

.add-second {
    font-size: 1rem;
    margin-left: 3px;
}

.add-icon {
    display: flex;
    align-items: center;
}

/*box3*/
.nav-search {
    display: flex;
    justify-content: space-evenly;
    background-color: rgb(236, 217, 0);
    color: rgb(23, 22, 22);
    height: 40px;
    width: 620px;

    border-radius: 4px;
}

.nav-search:hover {
    border-color: rgb(241, 154, 40);
}

.search-select {
    background-color: #f3f3f3;
    width: 50px;
    text-align: center;
    border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
    border: none;


}

.search-input {
    width: 100%;
    font-size: 1rem;
    border: none;


}

.search-icon {
    width: 45px;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: rgb(255, 160, 7);
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}

/* box4*/
span {
    font-size: 0.7rem;

}

.nav-second {
    font-size: 0.85rem;
    font-weight: 700;
}

/* box6*/
.nav-card i {
    font-size: 31px;
    line-height: 15px;
    font-weight: 700;
}

/* panel*/
.panel {
    height: 40px;
    background-color: #222f3d;
    display: flex;
    color: white;
    align-items: center;
    justify-content: space-evenly;
}

.panel-ops p {
    display: inline;
    margin: 15px;

}

.panel-ops {
    width: 70%;
    font-size: 0.85rem;


}

.panel-deals {
    font-size: 0.9rem;
    font-weight: 700;
}

/* hero-section*/
.hero-section {
    background-image: url("hero.jpg");
    background-size: cover;
    height: 400px;
    display: flex;
    justify-content: center;
}

.hero-text {
    background-color: #f3f3f3;
    color: black;
    height: 40px;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 0.85rem;
    position: relative;
    top: 250px;
    width: 96.8%;


}

.hero-text a {
    color: blue;
}

/*.shop-section*/
.shop-section {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-evenly;
    background-color: #e2e7e6;

}

.box {
    height: 400px;
    background-color: white;
    width: 23%;
    padding: 20px 0px 15px;
    margin-top: 10px;


}

.box-img {
    height: 300px;
    background-size: cover;
    background-repeat: none;
    margin-top: 1rem;
    margin-bottom: 1rem;
}

.box-content {
    margin-left: 10px;
    margin-right: 10px;
}

.box-content p {
    color: blue;
    margin-top: 33px;
}

/*footer*/
footer {
    margin-top: 15px;
}

.foot-panel1 {
    background-color: #37475a;
    color: white;
    height: 49px;
    display: flex;
    justify-content: center;
    align-items: center;
}

.foot-panel2 {
    background-color: #222f3d;
    color: white;
    height: 400px;
    display: flex;
    justify-content: space-evenly;



}

ul {
    margin-top: 15px;
}

ul a {
    display: block;
    font-size: 0.85rem;
    margin-top: 10px;
    color: #cccccc;
}

.foot-panel3 {
    background-color: #000000;
    color: aliceblue;
    border-top: 0.5px solid white;
    height: 70px;
    display: flex;
    justify-content: center;
    align-items: center;
}

.logo {
    background-image: url("https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTkXyHmHFvc7oj3HNpoDtU7YFAs16H2w562qA&s ");
    height: 50px;
    width: 100%;
    background-size: cover;
    width: 100px;
}

.foot-panel4 {
    background-color: #000000;
    color: white;

}

.pages {
    font-size: 0.7rem;
    text-align: center;
    padding-top: 25px;

}

.copyright {

    font-size: 0.7rem;
    text-align: center;
    padding-bottom: 10px;
}
